---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ExampleCard from '../../../components/ExampleCard.astro';
import NextCard from '../../../components/NextCard.astro';
import ExamplePanel from '../../../components/ExamplePanel.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { t, localeStaticPaths, type Locale } from '../../../i18n';
import { getExamples, getNiches } from '../../../lib/content';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const examples = await getExamples();
const allNiches = await getNiches();
// All general categories are in the filter; empty ones show a short "nothing yet" note.
const niches = allNiches;
const nicheLabel = (id: string) => allNiches.find((n) => n.id === id)?.data.label[locale] ?? id;
---

<BaseLayout locale={locale} title={d.meta.examplesTitle} description={d.meta.examplesDescription} path="examples">
  <section class="section theme-light ex-page" data-label={d.sections.examples} aria-labelledby="ex-title">
    <div class="container-x">
      <header class="ex-page-head">
        <h1 id="ex-title" class="h-page">{d.examplesPage.title}</h1>
        <p class="lead-text">{d.examplesPage.lead}</p>
      </header>

      <div class="filter" role="group" aria-label={d.examples.filterLabel} data-filter hidden>
        <button type="button" class="filter-btn" aria-pressed="true" data-niche="">{d.examples.filterAll}</button>
        {
          niches.map((n) => (
            <button type="button" class="filter-btn" aria-pressed="false" data-niche={n.id}>
              {n.data.label[locale]}
            </button>
          ))
        }
      </div>

      <div class="ex-grid" data-examples-grid>
        {
          examples.map((e, i) => (
            <ExampleCard example={e} locale={locale} nicheLabel={nicheLabel(e.data.niche)} index={i} level="h2" place="grid" />
          ))
        }
        <NextCard locale={locale} number={examples.length + 1} place="grid" level="h2" />
      </div>
      <p class="ex-empty" data-empty hidden>{d.examples.empty}</p>
      <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>
    </div>
  </section>
  <div class="dark-gap"></div>
  <LeadForm locale={locale} />
  <ExamplePanel locale={locale} examples={examples} nicheLabel={nicheLabel} />
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLElement>('[data-filter]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-examples-grid] > [data-niche]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const live = document.querySelector<HTMLElement>('[data-filter-status]');
  if (filter) {
    filter.hidden = false; // the filter needs JS; without it all examples are shown
    const buttons = Array.from(filter.querySelectorAll<HTMLButtonElement>('button'));
    const apply = (niche: string, push: boolean) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.niche === niche)));
      let shown = 0;
      cards.forEach((c) => {
        const on = !niche || c.dataset.niche === niche;
        c.hidden = !on;
        if (on) {
          shown++;
          c.classList.add('is-in');
        }
      });
      if (empty) empty.hidden = shown > 0;
      if (live) live.textContent = String(shown);
      if (push) {
        const u = new URL(location.href);
        if (niche) u.searchParams.set('niche', niche);
        else u.searchParams.delete('niche');
        history.replaceState(null, '', u);
      }
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.niche ?? '', true)));
    const initial = new URLSearchParams(location.search).get('niche') ?? '';
    if (initial && buttons.some((b) => b.dataset.niche === initial)) apply(initial, false);
  }
</script>

<style>
  .ex-page-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .filter {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: -1rem;
    padding-inline: 1rem;
  }
  .filter::-webkit-scrollbar {
    display: none;
  }
  .filter-btn {
    flex-shrink: 0;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--color-line-dark);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .filter-btn:hover {
    border-color: var(--color-ink);
  }
  .filter-btn[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
  .ex-grid {
    display: grid;
    gap: 3rem 1.5rem;
  }
  @media (min-width: 48rem) {
    .ex-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .ex-empty {
    padding: 2rem 0;
    color: var(--color-muted-dark);
  }
  .dark-gap {
    height: 1px;
    background: var(--color-line-dark);
  }
</style>
