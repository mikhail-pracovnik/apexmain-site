---
/**
 * Services page: every service from src/content/services with who it is for and what is included, in the same
 * horizontal rail as on the home page (Rail.astro: swipe, drag, snapping, arrows, the next card peeking).
 * Anchors (#site, …) from the home cards and the index below the title scroll the rail to the service.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServiceScene from '../../../components/ServiceScene.astro';
import Rail from '../../../components/Rail.astro';
import DarkBackdrop from '../../../components/DarkBackdrop.astro';
import { t, url, fill, localeStaticPaths, type Locale } from '../../../i18n';
import { getServices, formatPrice } from '../../../lib/content';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const services = await getServices();
const contact = url(locale, 'contact');
---

<BaseLayout locale={locale} title={d.meta.servicesTitle} description={d.meta.servicesDescription} path="services">
  <section class="section page-top svc-page dark-lit" data-label={d.nav.services} aria-labelledby="svc-title">
    <DarkBackdrop variant="services-page" fade="bottom" />
    <div class="container-x">
      <header class="svc-head">
        <h1 id="svc-title" class="h-page">{d.servicesPage.title}</h1>
        <p class="lead-text">{d.servicesPage.lead}</p>
      </header>

      <nav class="svc-index" aria-label={d.servicesPage.title}>
        {
          services.map((s, i) => (
            <a href={`#${s.id}`}>
              <span>0{i + 1}</span>
              {s.data.title[locale]}
            </a>
          ))
        }
      </nav>

    </div>
    <div class="reveal" style="--i:1">
      <Rail locale={locale} label={d.servicesPage.title} kind="cards">
        {
          services.map((s, i) => {
            const price = s.data.priceFrom
              ? fill(d.services.priceFrom, { price: formatPrice(s.data.priceFrom, d.services.currency) })
              : d.services.priceOnRequest;
            return (
              <li class="rail-item">
              <article class="svc" id={s.id} aria-labelledby={`${s.id}-t`}>
                <div class="svc-media">{s.data.scene && <ServiceScene scene={s.data.scene} locale={locale} />}</div>
                <div class="svc-body">
                  <p class="eyebrow">0{i + 1}</p>
                  <h2 id={`${s.id}-t`} class="svc-title">
                    {s.data.title[locale]}
                  </h2>
                  <p class="svc-desc">{s.data.description[locale]}</p>
                  {s.data.audience && (
                    <div class="svc-block">
                      <h3>{d.servicesPage.forWhom}</h3>
                      <p>{s.data.audience[locale]}</p>
                    </div>
                  )}
                  {s.data.includes && (
                    <div class="svc-block">
                      <h3>{d.servicesPage.includes}</h3>
                      <ul class="svc-includes">
                        {s.data.includes[locale].map((x) => (
                          <li>{x}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                  <div class="svc-foot">
                    <span class="svc-price">{price}</span>
                    <a href={`${contact}?service=${encodeURIComponent(s.data.title[locale])}#lead`} class="btn btn-primary">
                      {d.servicesPage.cta}
                    </a>
                  </div>
                </div>
              </article>
              </li>
            );
          })
        }
      </Rail>
    </div>
  </section>
</BaseLayout>

<style>
  .svc-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 64rem) {
    .svc-head {
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
  }
  .svc-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 64rem) {
    .svc-index {
      margin-bottom: 2rem;
    }
  }
  .svc-index a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    font-weight: 600;
    transition: border-color 0.2s;
  }
  .svc-index a:hover {
    border-color: var(--color-paper);
  }
  .svc-index span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  /* barely translucent, no blur (as the home cards): the page's light and grid show through a little.
     A rail card: the scene on top, the text below; the price and the button stay at the bottom. */
  .svc {
    display: flex;
    flex-direction: column;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-card);
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25);
    --color-muted: #c4cbd5;
    overflow: hidden;
    scroll-margin-top: 6rem;
  }
  .svc-media {
    position: relative;
    flex-shrink: 0;
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid var(--color-line);
  }
  .svc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.25rem;
  }
  @media (min-width: 64rem) {
    .svc-body {
      padding: 1.5rem;
    }
  }
  .svc-title {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2rem);
  }
  .svc-desc {
    font-size: 1.0625rem;
    color: var(--color-muted);
  }
  .svc-block h3 {
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-apex);
  }
  .svc-block p {
    color: var(--color-muted);
  }
  .svc-includes {
    display: grid;
    gap: 0.4rem;
  }
  .svc-includes li {
    position: relative;
    padding-left: 1.25rem;
  }
  .svc-includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 1px;
    background: var(--color-apex);
  }
  .svc-foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .svc-price {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>
