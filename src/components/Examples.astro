---
import Rail from './Rail.astro';
import ExampleCard from './ExampleCard.astro';
import NextCard from './NextCard.astro';
import MoreLink from './MoreLink.astro';
import { t, url, type Locale } from '../i18n';
import { getExamples, getNiches } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
// every example (not hidden), by `order`
const examples = await getExamples();
const niches = await getNiches();
const nicheLabel = (id: string) => niches.find((n) => n.id === id)?.data.label[locale] ?? id;
---

<section class="section theme-light" id="examples" data-label={d.sections.examples} aria-labelledby="examples-title">
  <div class="container-x">
    <header class="ex-head">
      <div class="grid gap-5">
        <p class="eyebrow reveal">{d.examples.eyebrow}</p>
        <h2 id="examples-title" class="h-section reveal" style="--i:1">{d.examples.title}</h2>
      </div>
      <p class="lead-text reveal" style="--i:2">{d.examples.lead}</p>
    </header>
  </div>
  <div class="reveal" style="--i:3">
    <Rail locale={locale} label={d.examples.listLabel} kind="cards">
      {
        examples.map((e, i) => (
          <li class="rail-item">
            <ExampleCard example={e} locale={locale} nicheLabel={nicheLabel(e.data.niche)} index={i} reveal={false} />
          </li>
        ))
      }
      <li class="rail-item">
        <NextCard locale={locale} />
      </li>
    </Rail>
  </div>
  <MoreLink locale={locale} href={url(locale, 'examples')} label={d.examples.moreLabel} />
</section>

<style>
  .ex-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 64rem) {
    .ex-head {
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
  }
</style>
