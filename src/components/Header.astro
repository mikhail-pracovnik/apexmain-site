---
/**
 * Floating header plate: mark, current section, scroll progress, language, contact actions, menu.
 * On tablets/desktop the messenger and back-to-top buttons live here (nothing floats over content);
 * on phones they are in the bottom dock (MobileDock.astro).
 */
import BrandMark from './BrandMark.astro';
import { site } from '../config/site';
import { t, url, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path: string;
  withIntro: boolean;
}

const { locale, path, withIntro } = Astro.props;
const d = t(locale);
const home = url(locale);
const greeting = encodeURIComponent(d.messenger.greeting);

const pageLabel: Record<string, string> = {
  '': withIntro ? d.sections.intro : d.sections.hero,
  examples: d.nav.examples,
  services: d.nav.services,
  process: d.nav.process,
  contact: d.nav.lead,
  privacy: d.footer.privacy,
};
const initialLabel = pageLabel[path] ?? site.name;
---

<header id="site-header" class="site-header">
  <div class="plate">
    <a href={home} class="plate-mark" aria-label={d.a11y.home}>
      <BrandMark id="header-mark" class="h-[18px] w-auto" />
    </a>
    <span class="plate-sep" aria-hidden="true"></span>
    <span class="plate-label" data-section-label>
      <span data-label-text>{initialLabel}</span>
    </span>

    <nav class="plate-lang" aria-label={d.a11y.language}>
      {
        locales.map((l) => (
          <a href={url(l, path)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined} aria-label={t(l).langName}>
            {t(l).langShort}
          </a>
        ))
      }
    </nav>

    <button type="button" class="plate-icon plate-top" data-to-top aria-label={d.toTop}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" stroke="currentColor" stroke-width="1.9" fill="none"></path></svg
      >
    </button>

    <div class="plate-msg" data-fab>
      <button type="button" class="plate-icon" aria-expanded="false" aria-controls="header-msg-menu" data-fab-toggle>
        <span class="sr-only">{d.messenger.open}</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" d="M4 5.5h16v10.5H9.5L5 19.5V16H4z"
          ></path></svg
        >
      </button>
      <ul class="msg-menu" id="header-msg-menu">
        <li>
          <a href={`https://t.me/${site.contacts.telegram}?text=${greeting}`} target="_blank" rel="noopener">Telegram · @{site.contacts.telegram}</a>
        </li>
        <li>
          <a href={`https://wa.me/${site.contacts.whatsapp}?text=${greeting}`} target="_blank" rel="noopener">WhatsApp · {site.contacts.whatsappDisplay}</a>
        </li>
      </ul>
    </div>

    <a href={url(locale, 'contact')} class="plate-cta">{d.nav.cta}</a>

    <button type="button" class="plate-menu" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
      <span class="sr-only">{d.a11y.menuOpen}</span>
      <span class="burger" aria-hidden="true"><i></i><i></i></span>
    </button>

    <span class="plate-progress" aria-hidden="true"><span data-progress></span></span>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: max(0.75rem, env(safe-area-inset-top)) 0 auto 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    padding-inline: 0.75rem;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-out-expo);
  }
  /* Hidden while the intro plays (opacity only, so the mark position can still be measured). */
  :global(html.js.motion.has-intro:not(.intro-done)) .site-header {
    opacity: 0;
  }
  :global(html.js.motion.has-intro:not(.intro-done)) .site-header .plate {
    pointer-events: none;
  }

  .plate {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    max-width: 78rem;
    height: 3.5rem;
    padding: 0 0.5rem 0 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: rgb(16 20 27 / 0.82);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.6);
    pointer-events: auto;
  }
  .plate-mark {
    display: inline-flex;
    padding: 0.4rem 0;
  }
  .plate-sep {
    width: 1px;
    height: 1.1rem;
    background: var(--color-line);
  }
  .plate-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .plate-label [data-label-text] {
    display: inline-block;
    transition:
      transform 0.45s var(--ease-out-expo),
      opacity 0.3s;
  }
  .plate-label:global(.is-switching) [data-label-text] {
    transform: translateY(-110%);
    opacity: 0;
  }


  .plate-lang {
    gap: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .plate-lang a {
    padding: 0.45rem 0.55rem;
    border-radius: 0.375rem;
    color: var(--color-muted);
    transition: color 0.2s;
  }
  .plate-lang a:hover,
  .plate-lang a[aria-current] {
    color: var(--color-paper);
  }
  .plate-lang a[aria-current] {
    background: rgb(236 240 241 / 0.08);
  }
  .plate-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
    color: var(--color-paper);
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .plate-icon:hover {
    border-color: rgb(236 240 241 / 0.4);
  }
  /* Back-to-top appears after 50% of the page (class set in common.ts). */
  .plate-top {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0s 0.3s,
      border-color 0.2s;
  }
  .plate-top:global(.is-visible) {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .plate-msg {
    position: relative;
  }
  .msg-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    display: grid;
    gap: 0.25rem;
    min-width: 17rem;
    padding: 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: var(--color-ink-2);
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.8);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.2s,
      transform 0.3s var(--ease-out-expo),
      visibility 0s 0.3s;
  }
  .plate-msg:global(.is-open) .msg-menu {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .msg-menu a {
    display: block;
    padding: 0.7rem 0.9rem;
    border-radius: 0.375rem;
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .msg-menu a:hover {
    background: rgb(236 240 241 / 0.06);
  }
  .plate-cta {
    align-items: center;
    height: 2.5rem;
    padding: 0 1rem;
    border-radius: 0.375rem;
    background: var(--color-apex);
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.875rem;
    white-space: nowrap;
    transition: background-color 0.2s;
  }
  .plate-cta:hover {
    background: #6dd6e4;
  }
  /* Phones: language, messenger, back-to-top and CTA live in the menu / bottom dock. */
  @media (max-width: 47.99rem) {
    .plate-lang,
    .plate-msg,
    .plate-top,
    .plate-cta {
      display: none;
    }
  }
  @media (min-width: 48rem) {
    .plate-lang,
    .plate-cta {
      display: inline-flex;
    }
    .plate-top {
      display: grid;
    }
    .plate-msg {
      display: block;
    }
  }

  .plate-menu {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.375rem;
    background: var(--color-paper);
    color: var(--color-ink);
    cursor: pointer;
  }
  .burger {
    display: grid;
    gap: 5px;
  }
  .burger i {
    display: block;
    width: 16px;
    height: 1.6px;
    background: currentColor;
  }

  .plate-progress {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
  }
  .plate-progress span {
    display: block;
    height: 100%;
    background: var(--color-apex);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
  }
</style>
