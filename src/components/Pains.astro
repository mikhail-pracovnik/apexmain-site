---
/**
 * Section 01: client phrases as a rail of cards (illustration + quote). A card opens the panel
 * (PainPanel.astro) with the quote, "what we do" and a link to the service.
 */
import Rail from './Rail.astro';
import PainPanel from './PainPanel.astro';
import PainPicture from './PainPicture.astro';
import { t, type Locale } from '../i18n';
import { getPains } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const pains = await getPains();
---

<section class="section theme-light pains" id="pains" data-label={d.sections.pains} aria-labelledby="pains-title">
  <div class="container-x">
    <header class="pains-head">
      <p class="eyebrow reveal">{d.pains.eyebrow}</p>
      <h2 id="pains-title" class="h-section pains-title reveal" style="--i:1">{d.pains.title}</h2>
      <p class="lead-text reveal" style="--i:2">{d.pains.lead}</p>
    </header>
  </div>

  <div class="reveal" style="--i:3">
    <Rail locale={locale} label={d.pains.listLabel} kind="pains">
      {
        pains.map((p) => (
          <li class="rail-item">
            <button
              type="button"
              class="pain-card"
              style={`--tone:${p.data.tone}`}
              data-pain-open={p.id}
              aria-haspopup="dialog"
              aria-controls="pain-panel"
            >
              <PainPicture image={p.data.image} class="pain-card-img" sizes="(max-width: 767px) 40vw, (max-width: 1023px) 28vw, 31vw" />
              <span class="pain-card-quote">«{p.data.quote[locale]}»</span>
            </button>
          </li>
        ))
      }
    </Rail>
  </div>

  <PainPanel locale={locale} pains={pains} />
</section>

<style>
  /* whole words only: on narrow phones auto hyphenation split "заявки" */
  .pains-title {
    hyphens: manual;
  }
  .pains-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 64rem) {
    .pains-head {
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
  }

  /* Card: the picture fills the top with its own background, the card continues in the same tone
     (--tone, sampled from the picture), so there is no seam between picture and card. */
  .pain-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: 0.875rem;
    background: var(--tone);
    overflow: hidden;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 1px 0 rgb(10 12 17 / 0.04);
    transition:
      transform 0.35s var(--ease-out-expo),
      box-shadow 0.35s;
    -webkit-tap-highlight-color: transparent;
  }
  @media (min-width: 64rem) {
    .pain-card {
      border-radius: var(--radius-card);
    }
  }
  @media (hover: hover) {
    .pain-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 36px -24px rgb(10 12 17 / 0.45);
    }
  }
  .pain-card:active {
    transform: scale(0.985);
  }
  .pain-card :global(.pain-card-img) {
    display: block;
    width: 100%;
    aspect-ratio: 928 / 1152;
  }
  .pain-card :global(.pain-card-img img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pain-card-quote {
    /* ≥ 13px on the narrowest card (≈135px on a 360px phone), up to 22px on wide screens */
    padding: max(0.5rem, calc(var(--w) * 0.07)) max(0.4375rem, calc(var(--w) * 0.055)) max(0.75rem, calc(var(--w) * 0.08));
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.8125rem, calc(var(--w) * 0.097), 1.375rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: pretty;
    overflow-wrap: break-word;
    hyphens: auto;
  }
</style>
