---
import { t, type Locale } from '../i18n';
import { getPains, getServices } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const pains = await getPains();
const services = await getServices();
const serviceTitle = (id: string) => services.find((s) => s.id === id)?.data.title[locale];
---

<section class="section" id="pains" data-label={d.sections.pains} aria-labelledby="pains-title">
  <div class="container-x pains-grid">
    <header class="pains-head">
      <p class="eyebrow reveal">{d.pains.eyebrow}</p>
      <h2 id="pains-title" class="h-section reveal" style="--i:1">{d.pains.title}</h2>
      <p class="lead-text reveal" style="--i:2">{d.pains.lead}</p>
    </header>

    <div class="pains-list">
      {
        pains.map((p, i) => (
          <details class="pain reveal" name="pains" style={`--i:${i % 3}`} open={i === 0 ? true : undefined}>
            <summary>
              <span class="pain-num">0{i + 1}</span>
              <span class="pain-quote">«{p.data.quote[locale]}»</span>
              <span class="pain-icon" aria-hidden="true" />
            </summary>
            <div class="pain-body">
              <p class="pain-label">{d.pains.solution}</p>
              <p>{p.data.answer[locale]}</p>
              {serviceTitle(p.data.service) && (
                <a class="pain-link" href={`#service-${p.data.service}`}>
                  {serviceTitle(p.data.service)}
                  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                    <path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.8" fill="none" />
                  </svg>
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pains-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 64rem) {
    .pains-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 5rem;
      align-items: start;
    }
    .pains-head {
      position: sticky;
      top: 8rem;
    }
  }
  .pains-head {
    display: grid;
    gap: 1.25rem;
  }
  .pains-list {
    border-top: 1px solid var(--color-line);
  }
  .pain {
    border-bottom: 1px solid var(--color-line);
  }
  .pain summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 1rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  .pain summary::-webkit-details-marker {
    display: none;
  }
  .pain-num {
    padding-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .pain-quote {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 3.2vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    transition: color 0.25s;
  }
  .pain summary:hover .pain-quote {
    color: #fff;
  }
  .pain-icon {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: 0.1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    transition:
      transform 0.4s var(--ease-out-expo),
      background-color 0.25s,
      border-color 0.25s;
  }
  .pain-icon::before,
  .pain-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.6px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .pain-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .pain[open] .pain-icon {
    transform: rotate(45deg);
    border-color: var(--color-apex);
    color: var(--color-apex);
  }
  .pain-body {
    display: grid;
    gap: 0.75rem;
    padding: 0 3.25rem 1.75rem 2.15rem;
    color: var(--color-muted);
  }
  :global(html.motion) .pain[open] .pain-body {
    animation: pain-in 0.6s var(--ease-out-expo);
  }
  @keyframes pain-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .pain-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-apex);
  }
  .pain-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    transition: border-color 0.2s;
  }
  .pain-link:hover {
    border-color: var(--color-paper);
  }
  @media (max-width: 40rem) {
    .pain-body {
      padding-right: 0;
    }
  }
</style>
