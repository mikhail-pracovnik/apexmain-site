---
/**
 * Phone-only bottom dock with messenger buttons and back-to-top. Always visible once the intro is done;
 * the page reserves its height (body padding + shorter first screen), so it never covers page content.
 */
import { site } from '../config/site';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
const greeting = encodeURIComponent(d.messenger.greeting);
---

<div class="dock" data-dock>
  <a href={`https://t.me/${site.contacts.telegram}?text=${greeting}`} target="_blank" rel="noopener" class="dock-btn dock-primary">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
      ><path
        fill="currentColor"
        d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.2-8.3c.4-.4-.1-.6-.6-.2L6.1 13 1.3 11.5c-1-.3-1-1 .2-1.5L20.6 2.8c.9-.3 1.6.2 1.3 1.5Z"
      ></path></svg
    >
    {d.messenger.telegram}
  </a>
  <a href={`https://wa.me/${site.contacts.whatsapp}?text=${greeting}`} target="_blank" rel="noopener" class="dock-btn">
    {d.messenger.whatsapp}
  </a>
  <button type="button" class="dock-top" data-dock-top aria-label={d.toTop}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
      ><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" stroke="currentColor" stroke-width="1.9" fill="none"></path></svg
    >
  </button>
</div>

<style>
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 55;
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem max(0.5rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-ink) 90%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: transform 0.4s var(--ease-out-expo);
  }
  :global(html.js.motion.has-intro:not(.intro-done)) .dock {
    transform: translateY(110%);
  }
  @media (min-width: 48rem) {
    .dock {
      display: none;
    }
  }
  .dock-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    border: 1px solid rgb(236 240 241 / 0.25);
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .dock-primary {
    border-color: var(--color-apex);
    background: var(--color-apex);
    color: var(--color-ink);
  }
  .dock-top {
    display: grid;
    place-items: center;
    width: 2.75rem;
    border: 1px solid rgb(236 240 241 / 0.25);
    border-radius: 0.5rem;
    color: var(--color-paper);
  }
</style>
