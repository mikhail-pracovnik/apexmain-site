---
/**
 * Phone-only floating "island" with messenger buttons and back-to-top. Always visible once the intro is done.
 * It floats with gaps on the sides and below (env(safe-area-inset-bottom) included) — no full-width bar,
 * so it looks the same above a floating browser toolbar (new Safari) or a classic one (old Safari, Chrome).
 * The page reserves its height (--dock-h: body padding + shorter first screen).
 * The fixed .dock itself is fully transparent and its look lives on the inner .dock-bg layer:
 * Safari 26 tints the area under its toolbar with the background of fixed elements at the bottom edge,
 * so a dark .dock turned that area grey over light sections. With nothing to take from the dock,
 * Safari falls back to the body background, which follows the section at the bottom (common.ts).
 */
import { site } from '../config/site';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
const greeting = encodeURIComponent(d.messenger.greeting);
---

<div class="dock" data-dock>
  <span class="dock-bg" aria-hidden="true"></span>
  <a href={`https://t.me/${site.contacts.telegram}?text=${greeting}`} target="_blank" rel="noopener" class="dock-btn dock-primary">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
      ><path
        fill="currentColor"
        d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.2-8.3c.4-.4-.1-.6-.6-.2L6.1 13 1.3 11.5c-1-.3-1-1 .2-1.5L20.6 2.8c.9-.3 1.6.2 1.3 1.5Z"
      ></path></svg
    >
    {d.messenger.telegram}
  </a>
  <a href={`https://wa.me/${site.contacts.whatsapp}?text=${greeting}`} target="_blank" rel="noopener" class="dock-btn">
    {d.messenger.whatsapp}
  </a>
  <button type="button" class="dock-top" data-dock-top aria-label={d.toTop}>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
      ><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" stroke="currentColor" stroke-width="1.9" fill="none"></path></svg
    >
  </button>
</div>

<style>
  .dock {
    position: fixed;
    left: 0.75rem;
    right: 0.75rem;
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    z-index: 55;
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 0.4rem;
    /* 1px border width kept as padding: the layout inside is the same as with the border on the dock */
    padding: calc(0.4rem + 1px);
    transition: transform 0.4s var(--ease-out-expo);
  }
  /* The island's look: under the buttons (z-index -1 inside the dock's stacking context). */
  .dock-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid rgb(236 240 241 / 0.14);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--color-ink-2) 72%, transparent);
    --dock-blur: blur(18px) saturate(150%);
    backdrop-filter: var(--dock-blur);
    box-shadow:
      0 12px 32px -8px rgb(0 0 0 / 0.55),
      0 2px 6px rgb(0 0 0 / 0.25);
    transition: box-shadow 0.2s;
    pointer-events: none;
  }
  /* Over a light section a dark island needs only a short, soft shadow. */
  :global(html.page-light) .dock-bg {
    box-shadow:
      0 6px 14px -6px rgb(0 0 0 / 0.28),
      0 1px 3px rgb(0 0 0 / 0.12);
  }
  /* The prefixed copy lives in its own rule: in one rule the CSS minifier merges the pair and keeps only one of them. */
  @supports (-webkit-backdrop-filter: none) {
    .dock-bg {
      -webkit-backdrop-filter: var(--dock-blur);
    }
  }
  :global(html.intro-on:not(.intro-done)) .dock {
    transform: translateY(calc(100% + 2rem + env(safe-area-inset-bottom)));
  }
  @media (min-width: 48rem) {
    .dock {
      display: none;
    }
  }
  .dock-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem; /* 44px */
    border: 1px solid rgb(236 240 241 / 0.25);
    border-radius: 0.9rem;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-paper);
  }
  .dock-primary {
    border-color: var(--color-apex);
    background: var(--color-apex);
    color: var(--color-ink);
  }
  .dock-top {
    display: grid;
    place-items: center;
    width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid rgb(236 240 241 / 0.25);
    border-radius: 0.9rem;
    color: var(--color-paper);
  }
</style>
