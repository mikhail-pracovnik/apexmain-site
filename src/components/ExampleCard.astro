---
/**
 * Example card: a desktop browser window and a phone with the real mock-up inside (anonymised, under the
 * ApexMain brand). The desktop home page scrolls slowly through its first screens inside the window,
 * pauses and comes back; the phone does the same, out of step. Only transform moves; cards off screen
 * stand still (scripts/example-cards.ts); with reduced motion the first screen is shown.
 * Backdrop ("glow of the mock-up", owner's sketch, variant 1): the same mock-up's first screen, blurred at build
 * time (scripts/make-example-images.mjs), slightly enlarged so the blur's edges stay outside; a soft light in the
 * top left corner and a faint shade over it so the window and the phone stand out.
 * Caption: niche tag, business type, one line, "I want one like this" (to the lead form, as before).
 * The rest of the card opens the mock-up's panel on the examples page (/examples/#<id>).
 */
import type { CollectionEntry } from 'astro:content';
import { t, url, type Locale } from '../i18n';
import { cardBg, cardStrip, type PictureSet } from '../lib/example-media';

interface Props {
  example: CollectionEntry<'examples'>;
  locale: Locale;
  nicheLabel: string;
  index: number;
  /** Heading level inside the card. */
  level?: 'h3' | 'h2';
  /** Scroll-reveal animation (off inside a rail: cards off to the side would stay hidden). */
  reveal?: boolean;
  /** Where the card is shown: the home rail or the examples page grid (image sizes differ). */
  place?: 'rail' | 'grid';
}
const { example, locale, nicheLabel, index, level: H = 'h3', reveal = true, place = 'rail' } = Astro.props;
const d = t(locale);
const e = example.data;
const id = example.id;
const title = e.title[locale];
const wantHref = `${url(locale, 'contact')}?niche=${encodeURIComponent(e.niche)}&example=${encodeURIComponent(title)}#lead`;
const openHref = `${url(locale, 'examples')}#${id}`;

// CSS width of the window's screen (75% of the card) and of the phone's screen (17.08% of the card)
const CARD = {
  rail: ['(max-width: 767px) calc((100vw - 26px) / 1.18)', '(max-width: 1023px) calc((100vw - 64px) / 2.18)', 'calc((100vw - 92px) / 3.2)'],
  grid: ['(max-width: 767px) calc(100vw - 32px)', '(min-width: 1600px) 756px', 'calc((100vw - 88px) / 2)'],
}[place];
const sizes = (share: number) => CARD.map((s) => s.replace(/(calc\(.*\)|\d+px)$/, (m) => `calc(${m} * ${share})`)).join(', ');
const desktop = cardStrip(id, 'desktop');
const mobile = cardStrip(id, 'mobile');
const bg = cardBg(id);
const pics: [PictureSet, string, string][] = [
  [desktop, sizes(0.75), 'ex-win-screen'],
  [mobile, sizes(0.1708), 'ex-phone-screen'],
];
---

<article class:list={['example', reveal && 'reveal']} data-niche={e.niche} data-example-card style={`--i:${index % 2}`}>
  <div class="example-media" style={`--ex-bg:${bg.color}`}>
    <picture class="ex-bg" aria-hidden="true">
      <source type="image/avif" srcset={bg.avif} />
      <source type="image/webp" srcset={bg.webp} />
      <img src={bg.jpg} width={bg.width} height={bg.height} alt="" loading="lazy" decoding="async" draggable="false" />
    </picture>
    <span class="ex-bg-light" aria-hidden="true"></span>
    {
      pics.map(([p, s, cls]) => (
        <div class={cls === 'ex-win-screen' ? 'ex-win' : 'ex-phone'}>
          {cls === 'ex-win-screen' && (
            <span class="ex-win-bar" aria-hidden="true">
              <i />
              <i />
              <i />
              <b />
            </span>
          )}
          <div class={cls}>
            <picture class="ex-strip">
              <source type="image/avif" srcset={p.avif} sizes={s} />
              <source type="image/webp" srcset={p.webp} sizes={s} />
              <img src={p.src} srcset={p.jpg} sizes={s} width={p.width} height={p.height} alt="" loading="lazy" decoding="async" draggable="false" />
            </picture>
          </div>
        </div>
      ))
    }
  </div>
  <div class="example-body">
    <div class="example-text">
      <p class="example-tag">{nicheLabel}</p>
      <H class="example-title">
        <a class="example-open" href={openHref} data-example-open={id}>{title}</a>
      </H>
      <p class="example-summary">{e.summary[locale]}</p>
    </div>
    <a href={wantHref} class="btn btn-dark example-cta" data-want data-niche={e.niche} data-example={title}>
      {d.examples.cta}
      <svg class="arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
        ><path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg
      >
    </a>
  </div>
</article>

<script>
  import { initExampleCards } from '../scripts/example-cards';
  initExampleCards();
</script>

<style>
  .example {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .example[hidden] {
    display: none;
  }
  /* the title link covers the whole card; the "I want one" button sits above it */
  .example-open::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .example-open:focus-visible {
    outline: none;
  }
  .example:has(.example-open:focus-visible) .example-media {
    outline: 2px solid var(--color-apex-deep);
    outline-offset: 3px;
  }
  .example-cta {
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  /* ---------- Media: a browser window and a phone (proportions of the former 960×600 drawing) ---------- */
  .example-media {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-paper);
    box-shadow: 0 30px 60px -40px rgb(10 12 17 / 0.6);
    transform: translateZ(0);
  }
  /* backdrop: blurred mock-up at 90% over paper (its average colour until it loads), enlarged past the edges */
  .ex-bg {
    position: absolute;
    inset: -10%;
    background: var(--ex-bg);
    opacity: 0.9;
    transform: scale(1.1);
  }
  .ex-bg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ex-bg-light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 30% 20%, rgb(255 255 255 / 0.18), transparent 60%),
      rgb(0 0 0 / 0.08);
  }
  .ex-win {
    position: absolute;
    left: 4.167%;
    top: 8%;
    width: 75%;
    height: 80%;
    display: flex;
    flex-direction: column;
    border-radius: 1.46cqw;
    background: var(--color-ink);
    box-shadow:
      0 0 0 1px rgb(236 240 241 / 0.12),
      0 1.5cqw 4cqw -1cqw rgb(0 0 0 / 0.55);
    overflow: hidden;
  }
  .ex-win-bar {
    position: relative;
    flex: 0 0 3.54cqw;
    display: flex;
    align-items: center;
    gap: 0.75cqw;
    padding-left: 1.6cqw;
    background: #12151c;
    border-bottom: 1px solid rgb(236 240 241 / 0.08);
  }
  .ex-win-bar i {
    width: 0.94cqw;
    height: 0.94cqw;
    border-radius: 50%;
    background: rgb(236 240 241 / 0.18);
  }
  .ex-win-bar b {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 23cqw;
    height: 1.67cqw;
    border-radius: 1cqw;
    background: rgb(236 240 241 / 0.06);
    transform: translate(-50%, -50%);
  }
  .ex-win-screen,
  .ex-phone-screen {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: #fff;
  }
  .ex-phone {
    position: absolute;
    left: 76.67%;
    top: 26.33%;
    width: 18.75%;
    height: 62.67%;
    padding: 2.6cqw 0.83cqw 1cqw;
    display: flex;
    border-radius: 2.7cqw;
    background: var(--color-ink);
    box-shadow:
      0 0 0 0.62cqw rgb(3 3 6 / 0.6),
      0 0 0 calc(0.62cqw + 1px) rgb(236 240 241 / 0.16),
      0 2cqw 5cqw -1cqw rgb(0 0 0 / 0.6);
  }
  .ex-phone::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.9cqw;
    width: 5cqw;
    height: 1.25cqw;
    border-radius: 1cqw;
    background: rgb(236 240 241 / 0.1);
    transform: translateX(-50%);
  }
  .ex-phone-screen {
    border-radius: 1.7cqw;
  }
  .ex-strip,
  .ex-strip img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Slow scroll through the first screens (transform only), paused while the card is off screen. */
  :global(html.motion) .ex-strip {
    animation: ex-scroll-win 16s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    animation-play-state: paused;
  }
  :global(html.motion) .ex-phone .ex-strip {
    animation-name: ex-scroll-phone;
    animation-duration: 17s;
    animation-delay: -6s;
  }
  :global(html.motion) .example:global(.is-playing) .ex-strip {
    animation-play-state: running;
    will-change: transform;
  }
  /* the strip is three screens tall and the screen shows about one: it travels to the third
     (window: 1 − 0.4646 / 1.406 = 66.9% of the strip; phone: 1 − 0.3557 / 1.1095 = 67.9%) */
  @keyframes ex-scroll-win {
    0%,
    8% {
      transform: translateY(0);
    }
    52%,
    64% {
      transform: translateY(-66.9%);
    }
    80%,
    100% {
      transform: translateY(0);
    }
  }
  @keyframes ex-scroll-phone {
    0%,
    10% {
      transform: translateY(0);
    }
    54%,
    66% {
      transform: translateY(-67.9%);
    }
    82%,
    100% {
      transform: translateY(0);
    }
  }

  .example-body {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .example-tag {
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted-dark);
  }
  .example-title {
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
  }
  .example-open {
    color: inherit;
  }
  .example-summary {
    margin-top: 0.35rem;
    color: var(--color-muted-dark);
  }
</style>
