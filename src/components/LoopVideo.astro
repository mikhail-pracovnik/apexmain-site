---
import { asset } from '../i18n';

interface Props {
  video: { webm: string; mp4: string; poster: string };
  class?: string;
  /** 'visible' — small loops that may play together while on screen; default — only the most visible one plays. */
  play?: 'visible' | 'solo';
}
const { video, class: className, play = 'solo' } = Astro.props;
---

<!-- Decorative loop: loads and plays only while on screen (see scripts/common.ts). -->
<video
  class={className}
  muted
  loop
  playsinline
  disablepictureinpicture
  preload="none"
  poster={asset(video.poster)}
  data-lazy
  data-play={play}
  aria-hidden="true"
  tabindex="-1"
  width="640"
  height="400"
>
  <source data-src={asset(video.mp4)} type="video/mp4" />
  <source data-src={asset(video.webm)} type="video/webm" />
</video>
