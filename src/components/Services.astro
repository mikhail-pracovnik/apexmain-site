---
/** Home page: the services as a rail of cards (see Rail.astro); the button below leads to the services page. */
import Rail from './Rail.astro';
import ServiceTile from './ServiceTile.astro';
import { t, url, type Locale } from '../i18n';
import { getServices } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const services = await getServices();
---

<section class="section glow" id="services" data-label={d.sections.services} aria-labelledby="services-title">
  <div class="container-x">
    <header class="sec-head">
      <p class="eyebrow reveal">{d.services.eyebrow}</p>
      <h2 id="services-title" class="h-section reveal" style="--i:1">{d.services.title}</h2>
      <p class="lead-text reveal" style="--i:2">{d.services.lead}</p>
    </header>
  </div>
  <div class="reveal" style="--i:3">
    <Rail locale={locale} label={d.services.listLabel} kind="cards">
      {
        services.map((s, i) => (
          <li class="rail-item">
            <ServiceTile service={s} locale={locale} index={i} />
          </li>
        ))
      }
    </Rail>
  </div>
  <div class="container-x">
    <p class="mt-8">
      <a href={url(locale, 'services')} class="btn btn-ghost">
        {d.services.showAll}
        <svg class="arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
          ><path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg
        >
      </a>
    </p>
  </div>
</section>

<style>
  .sec-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 64rem) {
    .sec-head {
      gap: 2rem;
      margin-bottom: 4rem;
    }
  }
</style>
