---
/** Home page: the services as a rail of cards (see Rail.astro); "Learn more" below leads to the services page. */
import Rail from './Rail.astro';
import ServiceTile from './ServiceTile.astro';
import MoreLink from './MoreLink.astro';
import DarkBackdrop from './DarkBackdrop.astro';
import { t, url, type Locale } from '../i18n';
import { getServices } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const services = await getServices();
---

<section class="section dark-lit" id="services" data-label={d.sections.services} aria-labelledby="services-title">
  <DarkBackdrop variant="services" />
  <div class="container-x">
    <header class="sec-head">
      <p class="eyebrow reveal">{d.services.eyebrow}</p>
      <h2 id="services-title" class="h-section reveal" style="--i:1">{d.services.title}</h2>
      <p class="lead-text reveal" style="--i:2">{d.services.lead}</p>
    </header>
  </div>
  <div class="reveal" style="--i:3">
    <Rail locale={locale} label={d.services.listLabel} kind="cards">
      {
        services.map((s, i) => (
          <li class="rail-item">
            <ServiceTile service={s} locale={locale} index={i} />
          </li>
        ))
      }
    </Rail>
  </div>
  <MoreLink locale={locale} href={url(locale, 'services')} label={d.services.moreLabel} />
</section>

<style>
  .sec-head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 64rem) {
    .sec-head {
      gap: 2rem;
      margin-bottom: 2.75rem;
    }
  }
</style>
