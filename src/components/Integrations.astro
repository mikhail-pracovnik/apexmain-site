---
/**
 * "We integrate and set up": a compact sub-section (no number, half the usual section padding) with a strip
 * of monochrome logos drifting right to left.
 * Logos come from src/content/integrations.yaml; without a logo file the name is shown as text.
 * The strip pauses on hover/focus and the hovered logo shows its brand colours (<id>-color.svg next to the mono file);
 * with reduced motion it becomes a static wrapped row.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { t, asset, type Locale } from '../i18n';
import { getIntegrations } from '../lib/content';
import { inPublic } from '../lib/media';
import DarkBackdrop from './DarkBackdrop.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);

const items = (await getIntegrations()).map((it) => {
  const logo = inPublic(it.data.logo) ? it.data.logo : null;
  // Even out visual weight: square marks a bit taller, very wide wordmarks a bit lower.
  let ratio = 3;
  if (logo) {
    const vb = readFileSync(join(process.cwd(), 'public', logo), 'utf8').match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
    if (vb) ratio = Number(vb[1]) / Number(vb[2]);
  }
  const height = ratio < 1.5 ? 3.25 : ratio > 3.6 ? 1.9 : 2.4; // rem
  const colorLogo = logo ? logo.replace(/\.svg$/, '-color.svg') : null;
  return { id: it.id, name: it.data.name[locale], logo, color: inPublic(colorLogo) ? colorLogo : null, height, ratio };
});
---

<section class="section integ dark-lit" id="integrations" data-label={d.sections.integrations} aria-labelledby="integ-title">
  <DarkBackdrop variant="integrations" fade="bottom" />
  <div class="container-x integ-head">
    <p class="eyebrow reveal">{d.integrations.eyebrow}</p>
    <h2 id="integ-title" class="integ-title reveal" style="--i:1">{d.integrations.title}</h2>
    <p class="lead-text reveal" style="--i:2">{d.integrations.lead}</p>
  </div>

  <div class="marquee" data-marquee>
    {
      [0, 1].map((copy) => (
        <ul class="marquee-track" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((it) => (
            <li class="marquee-item" style={`--h:${it.height}rem;--w:${(it.height * it.ratio).toFixed(2)}rem`}>
              {it.logo ? (
                <>
                  <img src={asset(it.logo)} alt={copy === 0 ? it.name : ''} width="200" height="80" decoding="async" />
                  {it.color && <img class="logo-color" src={asset(it.color)} alt="" width="200" height="80" decoding="async" />}
                </>
              ) : (
                <span class="marquee-name">{it.name}</span>
              )}
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  <p class="container-x integ-note">{d.integrations.note}</p>
</section>

<style>
  .integ {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
    /* a sub-section: half the padding of a regular section */
    padding-block: 2.75rem;
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 64rem) {
    .integ {
      padding-block: 4.25rem;
    }
  }
  .integ-head {
    display: grid;
    gap: 1.25rem;
  }
  .integ-title {
    font-size: clamp(2rem, 5.5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* ---------- Logo strip ---------- */
  .marquee {
    --gap: clamp(3rem, 6vw, 6rem);
    display: flex;
    overflow: hidden;
    padding-block: 2rem;
    border-block: 1px solid var(--color-line);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--gap);
    padding-right: var(--gap);
    animation: marquee 18s linear infinite;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }
  .marquee-item {
    display: grid;
    place-items: center;
    grid-template-areas: 'logo';
    flex-shrink: 0;
    height: 3.5rem;
  }
  .marquee-item img {
    grid-area: logo;
    display: block;
    width: var(--w);
    height: var(--h);
    object-fit: contain;
    opacity: 0.78;
    transition: opacity 0.35s ease;
  }
  /* Hover: the brand-colour version fades in over the monochrome one. */
  .marquee-item .logo-color {
    opacity: 0;
  }
  .marquee-item:hover img:not(.logo-color) {
    opacity: 0;
  }
  .marquee-item:hover .logo-color {
    opacity: 1;
  }
  .marquee-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    white-space: nowrap;
    color: var(--color-paper);
    opacity: 0.78;
  }

  /* Reduced motion: no movement, a static wrapped row. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      flex-wrap: wrap;
      flex-shrink: 1;
      justify-content: center;
      row-gap: 2rem;
      padding-inline: 1rem;
      animation: none;
    }
    .marquee-track[aria-hidden] {
      display: none;
    }
  }

  .integ-note {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
