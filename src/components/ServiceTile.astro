---
/**
 * Home-page service card: number, live scene (ServiceScene, 4:3 as in the owner's prototype), name and one
 * sentence (`short`). The whole card leads to the service on the services page. Without a scene the media box
 * stays a neutral placeholder with the big faint number.
 */
import type { CollectionEntry } from 'astro:content';
import ServiceScene from './ServiceScene.astro';
import { url, type Locale } from '../i18n';

interface Props {
  service: CollectionEntry<'services'>;
  locale: Locale;
  index: number;
}
const { service, locale, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<a href={`${url(locale, 'services')}#${service.id}`} class="tile glass">
  <span class="tile-media">
    <span class="tile-ph" aria-hidden="true">{num}</span>
    {service.data.scene && <ServiceScene scene={service.data.scene} locale={locale} />}
  </span>
  <span class="tile-body">
    <span class="tile-num">{num}</span>
    <span class="tile-title">{service.data.title[locale]}</span>
    {service.data.short && <span class="tile-short">{service.data.short[locale]}</span>}
  </span>
  <svg class="tile-arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
    ><path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg
  >
</a>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.5rem 0.5rem 1.1rem;
    border-radius: var(--radius-card);
    /* glass like the menus (global .glass, dark set): the section's grid and light show through */
    transition: border-color 0.3s;
  }
  .tile:hover {
    border-color: rgb(148 178 220 / 0.32);
  }
  .tile:hover .tile-arrow {
    transform: translateX(3px);
    color: var(--color-apex);
  }
  .tile-media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: 0.875rem;
    background: var(--color-ink);
    overflow: hidden;
  }
  .tile-ph {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, calc(var(--w, 20rem) * 0.28), 7rem);
    color: rgb(148 178 220 / 0.12);
  }
  .tile-body {
    display: grid;
    gap: 0.45rem;
    padding-inline: 0.6rem 2.2rem;
  }
  .tile-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .tile-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .tile-short {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  @media (min-width: 64rem) {
    .tile-short {
      font-size: 1rem;
    }
  }
  .tile-arrow {
    position: absolute;
    right: 1rem;
    bottom: 1.2rem;
    color: var(--color-muted);
    transition:
      transform 0.3s var(--ease-out-expo),
      color 0.2s;
  }
</style>
