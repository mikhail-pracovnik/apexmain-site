---
/** Compact home-page service card: a small looping image and the name; links to the services page. */
import type { CollectionEntry } from 'astro:content';
import LoopVideo from './LoopVideo.astro';
import { url, type Locale } from '../i18n';
import { usableVideo } from '../lib/media';

interface Props {
  service: CollectionEntry<'services'>;
  locale: Locale;
  index: number;
}
const { service, locale, index } = Astro.props;
const video = usableVideo(service.data.videoMini);
---

<a href={`${url(locale, 'services')}#${service.id}`} class="tile reveal" style={`--i:${index}`}>
  <span class="tile-media">
    <span class="tile-num" aria-hidden="true">0{index + 1}</span>
    {video && <LoopVideo video={video} class="tile-video" play="visible" />}
  </span>
  <span class="tile-title">{service.data.title[locale]}</span>
  <svg class="tile-arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
    ><path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg
  >
</a>

<style>
  .tile {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: var(--color-ink-2);
    transition:
      border-color 0.3s,
      transform 0.4s var(--ease-out-expo);
  }
  .tile:hover {
    border-color: rgb(148 178 220 / 0.32);
  }
  .tile:hover .tile-arrow {
    transform: translateX(3px);
    color: var(--color-apex);
  }
  .tile-media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 0.65rem;
    background: var(--color-ink);
    overflow: hidden;
  }
  .tile-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.5rem;
    color: rgb(148 178 220 / 0.14);
  }
  .tile-media :global(.tile-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile-title {
    padding-inline: 0.4rem;
    padding-right: 1.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 3.6vw, 1.375rem);
    line-height: 1.15;
  }
  .tile-arrow {
    position: absolute;
    right: 0.75rem;
    bottom: 0.95rem;
    color: var(--color-muted);
    transition:
      transform 0.3s var(--ease-out-expo),
      color 0.2s;
  }
</style>
