---
/**
 * First screen: the intro over the hero, then the hero.
 *   Language choice (first visit to the Russian home page): the dim mark and three language buttons.
 *   Reel (one GSAP timeline, no input): the mark gets its outline, fills in with the turquoise peak,
 *   flies into the header, the hero opens.
 * What to show is decided before the first paint by the head script in BaseLayout; scripts/stage.ts plays it.
 * Timing and the mark position: config/intro.ts.
 * Behind the hero lies a dim "apex / main" wordmark made of dust (scripts/dust-wordmark.ts).
 * Without JS there is no intro and the wordmark is static text with the same brightness.
 */
import BrandMark from './BrandMark.astro';
import brand from '../data/brand-mark.json';
import { t, url, locales, htmlLang, accentParts, type Locale } from '../i18n';
import { intro } from '../config/intro';
import DarkBackdrop from './DarkBackdrop.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const peak = brand.shapes.find((s) => s.id === 'peak')!;
const [vx, vy, vw, vh] = brand.viewBox;
// Headline: always two lines, on every screen.
const [title1, title2] = d.hero.titleLines.map(accentParts);
---

<section class="stage dark-lit" id="top" data-label={d.sections.hero} data-stage data-dust="stacked-shift">
  <DarkBackdrop variant="hero" />
  <div class="hero-dust hero-in" aria-hidden="true">
    <canvas data-dust-canvas></canvas>
  </div>
  <p class="hero-static" aria-hidden="true">
    <span>apex</span>
    <span class="hero-static-main">main</span>
  </p>
  <div class="hero container-x">
    <p class="eyebrow hero-eyebrow hero-in" data-dust-top>{d.hero.eyebrow}</p>
    <h1 class="hero-title" data-dust-title style={`--fit:${d.hero.titleFitEm}`}>
      <span class="hero-in">{title1.map((p) => (p.accent ? <span class="accent">{p.text}</span> : p.text))}</span>
      <span class="hero-in">{title2.map((p) => (p.accent ? <span class="accent">{p.text}</span> : p.text))}</span>
    </h1>
    <div class="hero-bottom hero-in">
      <p class="hero-sub">{d.hero.sub}</p>
      <div class="hero-ctas">
        <a href="#lead" class="btn btn-primary">
          {d.hero.ctaPrimary}
          <svg class="arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
            ><path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg
          >
        </a>
        <a href={url(locale, 'examples')} class="btn btn-ghost">{d.hero.ctaSecondary}</a>
      </div>
    </div>
  </div>

  <div class="intro" aria-hidden="true" aria-label={d.intro.chooseLanguage} data-intro style={`--intro-y:${intro.markY};--gap:${intro.langsGap}rem`}>
    <div class="intro-bg" data-intro-bg></div>
    <div class="intro-anchor" data-intro-anchor>
      <div class="intro-fly" data-intro-fly>
        <BrandMark class="intro-ghost" />
        <svg class="intro-glow" viewBox={`${vx} ${vy} ${vw} ${vh}`} data-intro-glow>
          <defs>
            <filter id="peak-glow" x="-30%" y="-30%" width="160%" height="160%">
              <feGaussianBlur stdDeviation="28"></feGaussianBlur>
            </filter>
          </defs>
          <polygon points={peak.points.map((p) => p.join(',')).join(' ')} fill="#46C8D9" filter="url(#peak-glow)"></polygon>
        </svg>
        <BrandMark class="intro-fill" />
        <BrandMark variant="outline" class="intro-mark" />
      </div>
    </div>
    <ul class="intro-langs" data-intro-langs>
      {
        locales.map((l) => (
          <li>
            <a href={url(l)} hreflang={htmlLang[l]} lang={htmlLang[l]} class="intro-lang" data-intro-lang={l}>
              <span>{t(l).langName}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { initStage } from '../scripts/stage';
  initStage();
</script>

<style>
  .stage {
    position: relative;
    /* the dark-section background (DarkBackdrop) without isolation: the fixed intro inside the stage must
       stay above the header, so the stage makes no stacking context; the backdrop sits at z-index 0 as the
       first child, the dust (z-index 0, later in the markup) and the text (z-index 1) above it */
    isolation: auto;
  }
  .stage > :global(.db) {
    z-index: 0;
  }

  /* ---------- Hero ---------- */
  .stage {
    overflow: hidden;
  }
  /* dust wordmark behind the content */
  .hero-dust {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-dust canvas {
    position: absolute;
    left: 0;
    top: 0;
  }
  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    /* Phones/tablets (stacked): the text block sits at the bottom of the first screen, right above the
       phone dock; the wordmark fills the space between the header and the text (dust-wordmark.ts).
       svh = the viewport with the browser bars shown, so the buttons never go under the address bar. */
    align-content: end;
    min-height: calc(100svh - var(--dock-h));
    padding-top: 5.5rem;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
  }
  /* Desktop: the text block sits about the middle of the hero, a little above centre; the big
     wordmark lies behind it. The whole composition is moved down so the space between the header and
     "apex" equals the space below "main". --mark-h mirrors the wordmark height computed in
     dust-wordmark.ts (≈ 0.357 × viewport width, or the height left under the header);
     the wordmark script moves itself by the same --hero-shift. */
  @media (min-width: 68.75rem) {
    .stage {
      --plate-b: calc(max(0.75rem, env(safe-area-inset-top)) + 3.5rem);
      --mark-h: min(35.73vw, 100svh - 3vw - var(--plate-b) - 14px);
      --hero-shift: max(0px, calc((100svh - var(--plate-b) - var(--mark-h)) / 2 - 14px));
    }
    .hero {
      align-content: center;
      padding-top: 6rem;
      padding-bottom: 14vh;
      transform: translateY(var(--hero-shift));
    }
  }
  @media (min-width: 64rem) {
    .hero-eyebrow {
      font-size: 0.9375rem;
    }
  }
  .hero-eyebrow {
    margin-bottom: 1rem;
    /* may lie on the dust of the wordmark: almost white so it stays readable */
    color: rgb(232 238 241 / 0.92);
  }
  /* Narrow phones: the eyebrow stays on one line, so the dust wordmark above keeps its height */
  @media (max-width: 26rem) {
    .hero-eyebrow {
      font-size: 0.75rem;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
  }
  .hero-title {
    display: grid;
    /* Two lines on every screen. The size follows the screen width so the longer line of the current
       language fits: --fit = its width in em (i18n hero.titleFitEm, measured with the font). No line ever wraps. */
    font-size: min(calc((100vw - 2rem) / var(--fit, 11) * 0.99), 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .hero-title > span {
    display: block;
    white-space: nowrap;
  }
  @media (min-width: 48rem) {
    .hero-title {
      font-size: min(calc((100vw - 4rem) / var(--fit, 11) * 0.97), 4.5rem);
    }
  }
  @media (min-width: 64rem) {
    .hero-title {
      /* the longest line takes at most ~66% of the width */
      font-size: min(6.3vw, 8.5rem, calc(66vw / var(--fit, 11)));
    }
  }
  .hero-bottom {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 64rem) {
    .hero-bottom {
      margin-top: 2.25rem;
    }
  }
  .hero-sub {
    max-width: 34rem;
    font-size: 1.125rem;
    color: var(--color-muted);
  }
  @media (min-width: 64rem) {
    .hero-sub {
      max-width: 38rem;
      font-size: 1.375rem;
    }
    .hero-ctas .btn {
      min-height: 3.75rem;
      padding: 1rem 1.75rem;
      font-size: 1.0625rem;
    }
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: fit-content;
  }
  @media (max-width: 30rem) {
    .hero-ctas {
      width: 100%;
    }
    .hero-ctas .btn {
      flex: 1 1 100%;
    }
  }

  /* Static wordmark: no JS or reduced motion (same brightness as the dust: apex 50%, main 60%). */
  .hero-static {
    position: absolute;
    z-index: 0;
    left: 1rem;
    top: 5.1rem;
    display: grid;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc((100vw - 2rem) / 3.1);
    line-height: 0.8;
    letter-spacing: -0.01em;
    color: rgb(232 238 241 / 0.5);
    pointer-events: none;
    user-select: none;
  }
  .hero-static-main {
    padding-left: 0.57em; /* one letter */
    color: rgb(70 200 217 / 0.6);
  }
  @media (min-width: 68.75rem) {
    .hero-static {
      left: auto;
      right: 3vw;
      top: 50%;
      font-size: min(16vw, 52vh);
      transform: translateY(-45%);
    }
  }
  :global(html.dust-ready) .hero-static {
    display: none;
  }
  :global(html.js.motion:not(.dust-ready)) .hero-static {
    visibility: hidden; /* JS + motion: the dust takes over as soon as it is ready */
  }

  /* ---------- Intro overlay (fixed over everything while it is on) ----------
     Mark and buttons are placed in container units of the overlay (cqh = 1% of its height), so the mark
     sits at the same point with or without the buttons, and on the next page after a language switch. */
  .intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 80;
    container-type: size;
    /* blocks clicks on the hero underneath */
    pointer-events: auto;
    /* --gap (mark → buttons) and --intro-y come from config/intro.ts via the style attribute */
    --btn-h: 3rem;
    --btn-gap: 0.5rem;
    --langs-h: calc(var(--btn-h) * 3 + var(--btn-gap) * 2);
    --pad-t: max(1rem, env(safe-area-inset-top));
    --pad-b: calc(max(1rem, env(safe-area-inset-bottom)) + 0.5rem);
    /* Mark height: its usual size, smaller when the screen is too short for the mark and the buttons. */
    --mark-h: max(
      2.5rem,
      min(
        min(72cqw, 30rem) * 0.7,
        200cqh * (1 - var(--intro-y)) - 2 * (var(--gap) + var(--langs-h) + var(--pad-b)),
        200cqh * var(--intro-y) - 2 * var(--pad-t)
      )
    );
  }
  /* Safari 26 tints its toolbar area with the background of a fixed element at the bottom edge:
     dark while the intro covers the screen. Not while the mark flies: .intro-bg fades out then to reveal the hero. */
  :global(html:not(.intro-flying)) .intro {
    background-color: var(--color-ink);
  }
  :global(html.intro-on:not(.intro-done)) .intro,
  :global(html.intro-on.intro-flying) .intro {
    display: block;
  }
  .intro-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 45% at 50% calc(var(--intro-y) * 100%), rgb(70 200 217 / 0.07), transparent 70%),
      radial-gradient(max(1%, 60% * var(--glow-s)) max(1%, 50% * var(--glow-s)) at 10% 100%, rgb(40 80 160 / calc(0.12 * var(--glow-a))), transparent 70%),
      var(--color-ink);
  }
  .intro-anchor {
    position: absolute;
    left: 50%;
    top: calc(var(--intro-y) * 100cqh);
    height: var(--mark-h);
    width: calc(var(--mark-h) * 1473 / 1031);
    transform: translate(-50%, -50%);
  }
  .intro-fly {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .intro-fly > :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Clearly visible from the very first frame. */
  .intro-fly :global(.intro-ghost) {
    opacity: 0.26;
  }
  .intro-glow {
    opacity: 0;
  }
  /* The fill fades in shape by shape (opacity), under the outline */
  .intro-fly :global(.intro-fill polygon) {
    opacity: 0;
  }
  .intro-fly :global(.intro-mark polygon) {
    fill-opacity: 0;
    stroke-width: 9;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  /* Language buttons: only on the choice screen */
  .intro-langs {
    display: none;
    position: absolute;
    left: 50%;
    top: calc(var(--intro-y) * 100cqh + var(--mark-h) / 2 + var(--gap));
    gap: var(--btn-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateX(-50%);
  }
  :global(html.intro-pick) .intro-langs {
    display: grid;
  }
  .intro-lang {
    position: relative;
    display: grid;
    place-items: center;
    width: 15rem;
    height: var(--btn-h);
    border: 1px solid rgb(232 238 241 / 0.16);
    border-radius: 0.75rem;
    background: rgb(232 238 241 / 0.03);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(232 238 241 / 0.88);
    transition:
      border-color 0.2s,
      color 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  .intro-lang:focus-visible {
    border-radius: 0.75rem;
  }
  @media (hover: hover) {
    .intro-lang:hover {
      border-color: rgb(232 238 241 / 0.4);
    }
  }
  /* chosen: turquoise fill (opacity of a layer), dark text */
  .intro-lang::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--color-apex);
    opacity: 0;
    transition: opacity 0.15s;
  }
  .intro-lang > span {
    position: relative;
  }
  .intro-lang:global(.is-chosen) {
    color: var(--color-ink);
  }
  .intro-lang:global(.is-chosen)::before {
    opacity: 1;
  }
</style>
