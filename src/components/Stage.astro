---
/**
 * First screen: a three-step intro over the hero.
 *   step 1 — the mark gets its full outline,
 *   step 2 — the mark fills in, the turquoise peak lights up,
 *   step 3 — the mark flies into the header and the hero opens.
 * One wheel notch / swipe / arrow key = one step (see scripts/stage.ts).
 * Behind the hero lies a dim "apex / main" wordmark made of dust (scripts/dust-wordmark.ts).
 * Without JS or with reduced motion there is no intro and the wordmark is static text with the same brightness.
 */
import BrandMark from './BrandMark.astro';
import brand from '../data/brand-mark.json';
import { t, url, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const peak = brand.shapes.find((s) => s.id === 'peak')!;
const [vx, vy, vw, vh] = brand.viewBox;
---

<section class="stage glow" id="top" data-label={d.sections.hero} data-stage data-dust="stacked-shift">
  <div class="hero-dust hero-in" aria-hidden="true">
    <canvas data-dust-canvas></canvas>
  </div>
  <p class="hero-static" aria-hidden="true">
    <span>apex</span>
    <span class="hero-static-main">main</span>
  </p>
  <div class="hero container-x">
    <p class="eyebrow hero-eyebrow hero-in">{d.hero.eyebrow}</p>
    <h1 class="hero-title" data-dust-title>
      <span class="hero-in">{d.hero.line1}</span>
      <span class="hero-in">{d.hero.line2Before}<span class="accent">{d.hero.accent}</span>{d.hero.line2After}</span>
    </h1>
    <div class="hero-bottom hero-in">
      <p class="hero-sub" data-dust-clear>{d.hero.sub}</p>
      <div class="hero-ctas" data-dust-clear>
        <a href="#lead" class="btn btn-primary">
          {d.hero.ctaPrimary}
          <svg class="arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
            ><path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg
          >
        </a>
        <a href={url(locale, 'examples')} class="btn btn-ghost">{d.hero.ctaSecondary}</a>
      </div>
    </div>
  </div>

  <div class="intro" aria-hidden="true" data-intro>
    <div class="intro-bg" data-intro-bg></div>
    <div class="intro-anchor" data-intro-anchor>
      <div class="intro-fly" data-intro-fly>
        <BrandMark class="intro-ghost" />
        <svg class="intro-glow" viewBox={`${vx} ${vy} ${vw} ${vh}`} data-intro-glow>
          <defs>
            <filter id="peak-glow" x="-30%" y="-30%" width="160%" height="160%">
              <feGaussianBlur stdDeviation="28"></feGaussianBlur>
            </filter>
          </defs>
          <polygon points={peak.points.map((p) => p.join(',')).join(' ')} fill="#46C8D9" filter="url(#peak-glow)"></polygon>
        </svg>
        <BrandMark variant="outline" class="intro-mark" />
      </div>
    </div>
    <p class="intro-hint" data-intro-hint>
      <span>{d.intro.hint}</span>
      <span class="intro-steps" aria-hidden="true"><i data-step-dot></i><i data-step-dot></i><i data-step-dot></i></span>
    </p>
  </div>
</section>

<script>
  import { initStage } from '../scripts/stage';
  initStage();
</script>

<style>
  .stage {
    position: relative;
  }

  /* ---------- Hero ---------- */
  .stage {
    overflow: hidden;
  }
  /* dust wordmark behind the content */
  .hero-dust {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-dust canvas {
    position: absolute;
    left: 0;
    top: 0;
  }
  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: start;
    /* first screen ends above the phone dock */
    min-height: calc(100svh - var(--dock-h));
    /* phones/tablets: the wordmark sits behind and above the headline, which starts mid-wordmark */
    padding-top: calc(5rem + 18vw);
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
  }
  @media (min-width: 64rem) {
    .hero {
      align-content: center;
      padding-top: 7rem;
      padding-bottom: 4rem;
    }
  }
  .hero-eyebrow {
    margin-bottom: 1rem;
  }
  .hero-title {
    display: grid;
    /* phones: 38–40px */
    font-size: clamp(2.375rem, 10.4vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  @media (min-width: 64rem) {
    .hero-title {
      max-width: 62rem;
      font-size: min(5.6vw, 7.5rem);
    }
  }
  .hero-title > span {
    display: block;
  }
  .hero-bottom {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 64rem) {
    .hero-bottom {
      margin-top: 2.25rem;
    }
  }
  .hero-sub {
    max-width: 34rem;
    font-size: 1.125rem;
    color: var(--color-muted);
  }
  @media (min-width: 64rem) {
    .hero-sub {
      font-size: 1.25rem;
    }
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    width: fit-content;
  }
  @media (max-width: 30rem) {
    .hero-ctas {
      width: 100%;
    }
    .hero-ctas .btn {
      flex: 1 1 100%;
    }
  }

  /* Static wordmark: no JS or reduced motion (same brightness as the dust: apex 25%, main 30%). */
  .hero-static {
    position: absolute;
    z-index: 0;
    left: 1rem;
    top: 5.1rem;
    display: grid;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc((100vw - 2rem) / 3.1);
    line-height: 0.8;
    letter-spacing: -0.01em;
    color: rgb(236 240 241 / 0.25);
    pointer-events: none;
    user-select: none;
  }
  .hero-static-main {
    padding-left: 0.57em; /* one letter */
    color: rgb(70 200 217 / 0.3);
  }
  @media (min-width: 64rem) {
    .hero-static {
      left: auto;
      right: 3vw;
      top: 50%;
      font-size: min(16vw, 52vh);
      transform: translateY(-45%);
    }
  }
  :global(html.dust-ready) .hero-static {
    display: none;
  }
  :global(html.js.motion:not(.dust-ready)) .hero-static {
    visibility: hidden; /* JS + motion: the dust takes over as soon as it is ready */
  }

  /* ---------- Intro overlay (fixed over everything while it plays) ---------- */
  .intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 80;
    /* blocks clicks on the hero underneath while the intro plays */
    pointer-events: auto;
    touch-action: none;
  }
  :global(html.js.motion.has-intro:not(.intro-done)) .intro,
  :global(html.js.motion.has-intro.intro-flying) .intro {
    display: block;
  }
  .intro-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 45% at 50% 46%, rgb(70 200 217 / 0.07), transparent 70%),
      radial-gradient(60% 50% at 10% 100%, rgb(40 80 160 / 0.12), transparent 70%),
      var(--color-ink);
  }
  .intro-anchor {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(72vw, 30rem);
    aspect-ratio: 1473 / 1031;
    transform: translate(-50%, -50%);
  }
  .intro-fly {
    position: absolute;
    inset: 0;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .intro-fly > :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Clearly visible from the very first frame. */
  .intro-fly :global(.intro-ghost) {
    opacity: 0.26;
  }
  .intro-glow {
    opacity: 0;
  }
  .intro-fly :global(.intro-mark polygon) {
    fill-opacity: 0;
    stroke-width: 9;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .intro-hint {
    position: absolute;
    left: 50%;
    bottom: max(2.25rem, env(safe-area-inset-bottom));
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-paper);
    white-space: nowrap;
  }
  .intro-steps {
    display: flex;
    gap: 0.4rem;
  }
  .intro-steps i {
    width: 1.5rem;
    height: 2px;
    background: var(--color-line);
    transition: background-color 0.4s;
  }
  .intro-steps i:global(.is-on) {
    background: var(--color-apex);
  }
</style>
