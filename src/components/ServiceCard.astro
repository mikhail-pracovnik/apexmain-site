---
import type { CollectionEntry } from 'astro:content';
import LoopVideo from './LoopVideo.astro';
import { t, url, fill, type Locale } from '../i18n';
import { formatPrice } from '../lib/content';
import { usableVideo } from '../lib/media';

interface Props {
  service: CollectionEntry<'services'>;
  locale: Locale;
  index: number;
  /** Link "Discuss" to the form on this page (#lead) or to the home page form. */
  formOnPage?: boolean;
}
const { service, locale, index, formOnPage = true } = Astro.props;
const d = t(locale);
const s = service.data;
const video = usableVideo(s.video);
const price = s.priceFrom ? fill(d.services.priceFrom, { price: formatPrice(s.priceFrom, d.services.currency) }) : d.services.priceOnRequest;
const leadHref = formOnPage ? '#lead' : `${url(locale)}#lead`;
---

<article class="service spot reveal" id={`service-${service.id}`} style={`--i:${index % 2}`}>
  <div class="service-media">
    <div class="service-fallback" aria-hidden="true">
      <span class="service-num">0{index + 1}</span>
    </div>
    {video && <LoopVideo video={video} class="service-video" />}
  </div>
  <div class="service-body">
    <h3 class="service-title">{s.title[locale]}</h3>
    <p class="service-desc">{s.description[locale]}</p>
    {
      s.tags && (
        <ul class="service-tags">
          {s.tags[locale].map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
      )
    }
    <div class="service-foot">
      <span class="service-price">{price}</span>
      <a href={leadHref} class="service-link" data-want data-service={s.title[locale]}>
        {d.services.discuss}
        <svg class="arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
          ><path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg
        >
      </a>
    </div>
  </div>
</article>

<style>
  .service {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-ink-2);
    overflow: hidden;
    scroll-margin-top: 6rem;
    transition: border-color 0.3s;
  }
  .service:hover {
    border-color: rgb(236 240 241 / 0.22);
  }
  .service-media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-ink);
    overflow: hidden;
  }
  .service-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 80% at 80% 10%, rgb(70 200 217 / 0.12), transparent 70%),
      repeating-linear-gradient(90deg, rgb(236 240 241 / 0.04) 0 1px, transparent 1px 40px);
  }
  .service-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 4rem;
    color: rgb(236 240 241 / 0.1);
  }
  .service-media :global(.service-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }
  @media (min-width: 64rem) {
    .service-body {
      padding: 2rem;
    }
  }
  .service-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .service-desc {
    color: var(--color-muted);
  }
  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .service-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .service-price {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-paper);
  }
  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-apex);
  }
  .service-link:hover .arrow {
    transform: translateX(3px);
  }
  .service-link .arrow {
    transition: transform 0.3s var(--ease-out-expo);
  }
</style>
