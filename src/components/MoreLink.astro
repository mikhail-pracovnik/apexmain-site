---
/**
 * "Learn more" button under a home-page section (services, examples, process): one look, one place,
 * one visible label (i18n `more`); `label` tells the three apart for screen readers.
 */
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  href: string;
  /** Accessible name, starts with the visible text: "Подробнее об услугах". */
  label: string;
}
const { locale, href, label } = Astro.props;
const d = t(locale);
---

<div class="container-x more-row">
  <a href={href} class="btn btn-ghost" aria-label={label}>
    {d.more}
    <svg class="arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
      ><path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke="currentColor" stroke-width="1.8" fill="none"></path></svg
    >
  </a>
</div>

<style>
  .more-row {
    margin-top: 1.5rem;
  }
  @media (min-width: 64rem) {
    .more-row {
      margin-top: 2rem;
    }
  }
</style>
