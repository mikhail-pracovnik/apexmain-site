---
/**
 * Branded wireframe shown while an example has no real screenshots.
 * A desktop browser window + a phone, with one of six layouts.
 */
import { desktop, phone } from '../data/example-layouts';

interface Props {
  layout: number;
  class?: string;
}
const { layout, class: className } = Astro.props;

const n = ((layout - 1) % 6) + 1;
const uid = `ph${n}`;
---

<svg class={className} viewBox="0 0 960 600" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${uid}-img`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ECF0F1" stop-opacity="0.10"></stop>
      <stop offset="1" stop-color="#ECF0F1" stop-opacity="0.03"></stop>
    </linearGradient>
    <radialGradient id={`${uid}-glow`} cx="0.75" cy="0.2" r="0.8">
      <stop offset="0" stop-color="#46C8D9" stop-opacity="0.16"></stop>
      <stop offset="1" stop-color="#46C8D9" stop-opacity="0"></stop>
    </radialGradient>
    <pattern id={`${uid}-grid`} width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M32 0H0V32" fill="none" stroke="#94B2DC" stroke-opacity="0.05"></path>
    </pattern>
    <symbol id={`${uid}-peak`} viewBox="0 0 40 24">
      <path d="M2 22 14 4l8 12M18 22l10-14 10 14" fill="none" stroke="#ECF0F1" stroke-opacity="0.32" stroke-width="2"></path>
    </symbol>
  </defs>

  <rect width="960" height="600" style="fill: var(--color-ink-2)"></rect>
  <rect width="960" height="600" fill={`url(#${uid}-grid)`}></rect>
  <rect width="960" height="600" fill={`url(#${uid}-glow)`}></rect>

  <!-- Desktop browser -->
  <g transform="translate(40 48)">
    <rect width="720" height="480" rx="14" style="fill: var(--color-ink)" stroke="#ECF0F1" stroke-opacity="0.12"></rect>
    <circle cx="20" cy="17" r="4.5" fill="#ECF0F1" fill-opacity="0.18"></circle>
    <circle cx="36" cy="17" r="4.5" fill="#ECF0F1" fill-opacity="0.18"></circle>
    <circle cx="52" cy="17" r="4.5" fill="#ECF0F1" fill-opacity="0.18"></circle>
    <rect x="250" y="9" width="220" height="16" rx="8" fill="#ECF0F1" fill-opacity="0.06"></rect>
    <path d="M0 34H720" stroke="#ECF0F1" stroke-opacity="0.1"></path>
    <g transform="translate(0 34)">
      {
        desktop[n].map((p) =>
          p.t === 'circle' ? (
            <circle cx={p.x} cy={p.y} r={p.r} fill={`url(#${uid}-img)`} stroke="#ECF0F1" stroke-opacity="0.1" />
          ) : p.t === 'img' ? (
            <g>
              <rect x={p.x} y={p.y} width={p.w} height={p.h} rx="8" fill={`url(#${uid}-img)`} />
              <use href={`#${uid}-peak`} x={p.x + p.w / 2 - 20} y={p.y + p.h / 2 - 12} width="40" height="24" />
            </g>
          ) : p.t === 'btn' ? (
            <rect x={p.x} y={p.y} width={p.w} height={p.h} rx={p.h / 2} fill="#46C8D9" />
          ) : p.t === 'chip' || p.t === 'chipA' ? (
            <rect
              x={p.x + 0.5}
              y={p.y + 0.5}
              width={p.w - 1}
              height={p.h - 1}
              rx={p.h / 2}
              fill="none"
              stroke={p.t === 'chipA' ? '#46C8D9' : '#ECF0F1'}
              stroke-opacity={p.t === 'chipA' ? 0.9 : 0.16}
            />
          ) : (
            <rect
              x={p.x}
              y={p.y}
              width={p.w}
              height={p.h}
              rx={p.t === 'block' ? 10 : Math.min(p.h / 2, 5)}
              fill="#ECF0F1"
              fill-opacity={p.t === 'title' ? 0.62 : p.t === 'line' ? 0.2 : 0.05}
            />
          ),
        )
      }
    </g>
  </g>

  <!-- Phone -->
  <g transform="translate(736 158)">
    <rect x="-6" y="-6" width="192" height="388" rx="30" style="fill: var(--color-ink)" fill-opacity="0.6"></rect>
    <rect width="180" height="376" rx="26" style="fill: var(--color-ink)" stroke="#ECF0F1" stroke-opacity="0.16"></rect>
    <rect x="66" y="10" width="48" height="12" rx="6" fill="#ECF0F1" fill-opacity="0.1"></rect>
    <g transform="translate(8 34)">
      {
        phone[n].map((p) =>
          p.t === 'circle' ? (
            <circle cx={p.x} cy={p.y} r={p.r} fill={`url(#${uid}-img)`} stroke="#ECF0F1" stroke-opacity="0.1" />
          ) : p.t === 'img' ? (
            <g>
              <rect x={p.x} y={p.y} width={p.w} height={p.h} rx="6" fill={`url(#${uid}-img)`} />
              <use href={`#${uid}-peak`} x={p.x + p.w / 2 - 12} y={p.y + p.h / 2 - 7} width="24" height="14" />
            </g>
          ) : p.t === 'btn' ? (
            <rect x={p.x} y={p.y} width={p.w} height={p.h} rx={p.h / 2} fill="#46C8D9" />
          ) : p.t === 'chip' || p.t === 'chipA' ? (
            <rect
              x={p.x + 0.5}
              y={p.y + 0.5}
              width={p.w - 1}
              height={p.h - 1}
              rx={p.h / 2}
              fill="none"
              stroke={p.t === 'chipA' ? '#46C8D9' : '#ECF0F1'}
              stroke-opacity={p.t === 'chipA' ? 0.9 : 0.16}
            />
          ) : (
            <rect
              x={p.x}
              y={p.y}
              width={p.w}
              height={p.h}
              rx={p.t === 'block' ? 8 : Math.min(p.h / 2, 4)}
              fill="#ECF0F1"
              fill-opacity={p.t === 'title' ? 0.62 : p.t === 'line' ? 0.2 : 0.05}
            />
          ),
        )
      }
    </g>
  </g>
</svg>
